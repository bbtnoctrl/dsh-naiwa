{
  "name": "naiwa-laugh",
  "version": "0.1.0",
  "description": "DSH plugin: make the Naiwa desktop pet laugh when an agent turn ends",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
